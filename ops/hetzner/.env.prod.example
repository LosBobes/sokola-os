# Production environment for SOKOLA (compose.prod.yml).
#
# On the server, copy this to ops/hetzner/.env (next to this file) and fill in
# real values, then run:
#   docker compose -f compose.prod.yml --env-file ops/hetzner/.env up --build -d
#
# This file is gitignored on the server (matches the repo's top-level .env
# ignore rule); never commit real secrets.

# Postgres password for the `sokola` role. The stack refuses to start
# without it.
# Generate with: openssl rand -hex 32
SOKOLA_DB_PASSWORD=

# Signs the auth session cookie. The stack refuses to start without it.
# Generate with: openssl rand -hex 32
SOKOLA_SESSION_SECRET=

# Google OIDC (optional — leave both blank to keep Google login disabled;
# see ops/GOOGLE_OIDC.md for how to obtain these from Google Cloud Console).
SOKOLA_GOOGLE_CLIENT_ID=
SOKOLA_GOOGLE_CLIENT_SECRET=

# Must exactly match an Authorized redirect URI configured on the Google
# OAuth client, and must use the real production domain (see
# ops/hetzner/Caddyfile).
SOKOLA_OIDC_REDIRECT_URL=https://sokola.losbobes.com/api/auth/google/callback
SOKOLA_WEB_POST_LOGIN_URL=https://sokola.losbobes.com/

# Server-side pepper mixed into every password hash. The stack refuses to start
# without it while password auth is enabled (the default). Rotating it
# invalidates every existing password hash, forcing all users to reset.
# Generate with: openssl rand -hex 32
SOKOLA_PASSWORD_PEPPER=

# Set to false to disable email+password login entirely and rely only on magic
# links / Google. Leaving it unset keeps password login on.
SOKOLA_PASSWORD_AUTH_ENABLED=true

# Magic-link (passwordless) login delivery. Leave SOKOLA_SMTP_HOST and
# SOKOLA_SMTP_FROM_EMAIL blank and the API will only LOG the login link to its
# own stdout — nothing reaches the user's inbox, so passwordless login is
# effectively broken. Set both for real delivery.
#
# Configured for the SendGrid SMTP relay, on the same SendGrid account gamgee
# uses (see gamgee/docs/sendgrid-setup.md for the account and domain-verification
# walkthrough). Host and username below are not secrets and are correct as-is;
# SendGrid's relay wants the literal string "apikey" as the username and the API
# key itself as the password.
#
# Fill in:
#   SOKOLA_SMTP_PASSWORD   - a SendGrid API key with Mail Send access. Prefer a
#                            separate key named sokola-prod over reusing
#                            gamgee's, so either can be revoked independently.
#   SOKOLA_SMTP_FROM_EMAIL - a sender address whose domain is verified in
#                            SendGrid (DKIM + SPF). Verification is per-domain,
#                            so if this differs from gamgee's sending domain it
#                            needs its own DNS records before mail will deliver.
SOKOLA_MAGIC_LINK_TTL_MINUTES=15
SOKOLA_SMTP_HOST=smtp.sendgrid.net
SOKOLA_SMTP_PORT=587
SOKOLA_SMTP_USERNAME=apikey
SOKOLA_SMTP_PASSWORD=
SOKOLA_SMTP_FROM_EMAIL=
SOKOLA_SMTP_USE_TLS=true
