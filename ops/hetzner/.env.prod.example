# Production environment for SOKOLA (compose.prod.yml).
#
# On the server, copy this to ops/hetzner/.env (next to this file) and fill in
# real values, then run:
#   docker compose -f compose.prod.yml --env-file ops/hetzner/.env up --build -d
#
# This file is gitignored on the server (matches the repo's top-level .env
# ignore rule); never commit real secrets.

# Postgres password for the `sokola` role. The stack refuses to start
# without it.
# Generate with: openssl rand -hex 32
SOKOLA_DB_PASSWORD=

# Signs the auth session cookie. The stack refuses to start without it.
# Generate with: openssl rand -hex 32
SOKOLA_SESSION_SECRET=

# Google OIDC (optional, leave both blank to keep Google login disabled;
# see ops/GOOGLE_OIDC.md for how to obtain these from Google Cloud Console).
SOKOLA_GOOGLE_CLIENT_ID=
SOKOLA_GOOGLE_CLIENT_SECRET=

# Must exactly match an Authorized redirect URI configured on the Google
# OAuth client, and must use the real production domain (see
# ops/hetzner/Caddyfile).
SOKOLA_OIDC_REDIRECT_URL=https://sokola.losbobes.com/api/auth/google/callback
SOKOLA_WEB_POST_LOGIN_URL=https://sokola.losbobes.com/

# Server-side pepper mixed into every password hash. The stack refuses to start
# without it while password auth is enabled (the default). Rotating it
# invalidates every existing password hash, forcing all users to reset.
# Generate with: openssl rand -hex 32
SOKOLA_PASSWORD_PEPPER=

# Set to false to disable email+password login entirely and rely only on
# Google. Leaving it unset keeps password login on; it is the default sign-in.
SOKOLA_PASSWORD_AUTH_ENABLED=true

# Contact protection (M04): school business contacts are stored as AEAD
# ciphertext, and deduplicated through a separately keyed HMAC fingerprint.
# Format is "<version>:<base64 key>", comma-separated; the highest version is
# written under and every listed version stays readable. Rotate by APPENDING
# ",2:<new key>" — never by replacing version 1, which would make every existing
# contact undecryptable. The stack refuses to start without both.
# Generate each with: openssl rand -base64 32
SOKOLA_CONTACT_ENCRYPTION_KEYS=
SOKOLA_CONTACT_FINGERPRINT_KEYS=
