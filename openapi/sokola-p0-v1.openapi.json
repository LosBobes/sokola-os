        "type": "object"
      },
      "GroupResponse": {
        "properties": {
          "capacity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capacity"
          },
          "capacity_mode": {
            "$ref": "#/components/schemas/GroupCapacityMode"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "capacity_mode",
          "capacity"
        ],
