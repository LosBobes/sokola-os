            "title": "Person Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AttendanceStatus"
          }
        },
        "required": [
          "person_id",
          "display_name",
          "status"
        ],
        "title": "AttendanceEntry",
        "type": "object"
      },
      "AttendanceException": {
        "properties": {
          "override_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AttendanceOverrideReasonCode"
              },
