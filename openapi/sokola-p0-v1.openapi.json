            "title": "Person Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AttendanceStatus"
          }
        },
        "required": [
          "person_id",
          "status"
        ],
        "title": "AttendanceException",
        "type": "object"
      },
      "AttendanceOverrideReasonCode": {
        "enum": [
          "LATE_ARRIVAL",
          "EARLY_LEAVE",
          "EXCUSED_ABSENCE",
          "OTHER"
        ],
        "title": "AttendanceOverrideReasonCode",
        "type": "string"
      },
      "AttendanceSheet": {
        "description": "The roster to display. Everyone defaults to PRESENT; the trainer edits only\nexceptions. ``attendance_version`` must be echoed back on save.",
        "properties": {
          "attendance_version": {
            "title": "Attendance Version",
            "type": "integer"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/AttendanceEntry"
            },
            "title": "Entries",
            "type": "array"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "attendance_version",
          "entries"
        ],
        "title": "AttendanceSheet",
        "type": "object"
      },
      "AttendanceStatus": {
        "enum": [
          "PRESENT",
          "ABSENT",
          "EXCUSED",
          "LATE"
        ],
        "title": "AttendanceStatus",
        "type": "string"
