# Copy to .env for local dev. Never commit real secrets.
SOKOLA_ENVIRONMENT=local
SOKOLA_DATABASE_URL=postgresql+psycopg://sokola:sokola@localhost:55432/sokola

# Dev-only header auth adapter. MUST be false anywhere but local.
SOKOLA_ALLOW_INSECURE_DEV_AUTH=true

# Default money currency (ISO 4217)
SOKOLA_DEFAULT_CURRENCY=RSD

# Session cookie signing secret. MUST be a long random value outside local.
SOKOLA_SESSION_SECRET=dev-insecure-session-secret-change-me

# Google OIDC. When both client id and secret are set, the Google login flow is
# enabled and the dev header adapter can be turned off. See ops/GOOGLE_OIDC.md.
SOKOLA_GOOGLE_CLIENT_ID=
SOKOLA_GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in the Google OAuth client.
SOKOLA_OIDC_REDIRECT_URL=http://localhost:5173/api/auth/google/callback
# Where the browser lands after a successful login.
SOKOLA_WEB_POST_LOGIN_URL=http://localhost:5173/
