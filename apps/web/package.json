{
  "name": "sokola-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript ../../openapi/sokola-p0-v1.openapi.json -o src/api/schema.d.ts",
    "cy:run": "cypress run",
    "cy:open": "cypress open"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^13.17.0",
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
